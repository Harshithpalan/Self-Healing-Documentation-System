# Optional: server-side defaults. Users can also enter their own key in the UI (Settings).
# LLM_PROVIDER: openai | anthropic | gemini | offline
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# For OpenAI-compatible providers (OpenAI, Groq, OpenRouter, Together, Ollama, LM Studio...)
LLM_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional: raises GitHub API rate limits for repository imports
GITHUB_TOKEN=
